# CAG environment variables template
# Copy this file to `.env` and fill in values.
# Do not store real secrets in version control.

# LLM provider: openai | anthropic | groq | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Preview API protection (optional)
CAG_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TIKTOKEN_ENABLED=false
EMBEDDING_CHECK_CTX_LENGTH=false

# Vector DB: chroma | pinecone
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=cag_erp_docs
PINECONE_API_KEY=
PINECONE_INDEX=cag-erp-index
PINECONE_ENV=us-east-1

# DB-first compiled knowledge
KNOWLEDGE_DB_PATH=./data/knowledge.db
ENABLE_KNOWLEDGE_COMPILER=true

# Retrieval and reasoning thresholds
RELEVANCE_THRESHOLD=0.7
MODERATE_RELEVANCE_THRESHOLD=0.55
RETRIEVAL_TOP_K=20
HALLUCINATION_THRESHOLD=0.3
CONFIDENCE_THRESHOLD=0.6
MAX_REASON_RETRIES=2
FAST_CONTEXT_SELECTION=true
FAST_CONTEXT_MIN_SCORE=4.0
ENABLE_CONVERSATION_ROUTER_LLM=false
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
CONTEXT_SELECTION_LIMIT=8
COMPLEX_CONTEXT_SELECTION_LIMIT=10
ADAPTIVE_RETRIEVAL_RETRY=true
ADAPTIVE_RETRY_TOP_K_BOOST=5
HYBRID_LEXICAL_RETRIEVAL=true
HYBRID_LEXICAL_TOP_K=8
STRICT_FAST_PROFILE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/cag.log
